---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { contactEmail, owner, taglineZh } from '../data/site';
import { withBase } from '../lib/paths';

interface Props {
	title?: string;
	description?: string;
}

const title = Astro.props.title ?? `${owner.nameZh} / ${owner.nameEn}`;
const description = Astro.props.description ?? taglineZh;
const pageUrl = Astro.site
	? new URL(`${import.meta.env.BASE_URL.replace(/\/?$/, '/')}`, Astro.site)
	: undefined;

const person = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: owner.nameZh,
	alternateName: owner.nameEn,
	email: `mailto:${contactEmail}`,
	description: taglineZh,
	sameAs: [owner.githubUrl, owner.xUrl],
	...(pageUrl ? { url: pageUrl.href } : {}),
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="zh_CN" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:creator" content={owner.xHandle} />
		{pageUrl && <link rel="canonical" href={pageUrl.href} />}
		{pageUrl && <meta property="og:url" content={pageUrl.href} />}
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="me" href={owner.githubUrl} />
		<link rel="me" href={owner.xUrl} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(person).replace(/</g, '\\u003c')} />
	</head>
	<body>
		<a class="skip" href="#content">跳到主要内容</a>
		<Header />
		<main id="content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
